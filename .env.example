DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
POSTGRES_DB=sis
POSTGRES_USER=sis
POSTGRES_PASSWORD=sis
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Client accounts
GOOGLE_CLIENT_ID=
FRONTEND_URL=http://localhost:3000
# Testing: client login accepts any 6-digit code. Empty = on while DJANGO_DEBUG=true. Set false before going live.
LOGIN_ANY_CODE=
# Real emails: django.core.mail.backends.smtp.EmailBackend plus EMAIL_HOST, EMAIL_PORT, EMAIL_HOST_USER, EMAIL_HOST_PASSWORD
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=SIS Esthetics <no-reply@sisesthetics.com>
# Brevo (free up to 300 emails a day): Brevo → SMTP & API → SMTP tab gives the login and the SMTP key.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# Reminder email this many hours before a visit (run `manage.py send_booking_reminders` every 10 minutes).
BOOKING_REMINDER_HOURS=24
# Push notifications on the phone. Run `python manage.py generate_vapid_keys` once. Empty = off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=info@sisesthetics.com
# AI assistant (chat on the site). Key from https://platform.claude.com → API keys. Empty = chat is hidden.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-opus-5-5
ASSISTANT_EFFORT=low
